top5_odds$OddsRatio > 1,
paste0(round((top5_odds$OddsRatio - 1) * 100, 1), "% HIGHER churn risk"),
paste0(round((1 - top5_odds$OddsRatio) * 100, 1), "% LOWER churn risk")
)
