library(tidyverse)
library(caret)
library(pROC)
library(e1071)
library(class)
library(randomForest)
library(ggplot2)
load('business_churn_data.RData')
ls()
str(business_data)
(summary(business_data))
na_count <- colSums(is.na(business_data))
na_count
na_percent <- (na_count / nrow(business_data)) * 100
na_percent
missing_report <- data.frame(
Variable = names(na_count),
Missing_Count = na_count,
Missing_Percentage = round(na_percent, 2)
)
missing_report
missing_report[missing_report$Missing_Count > 0, ]
barplot(na_count,
main = "Missing Values per Variable",
las = 2,
col = "red")
ggplot(business_data, aes(x = factor(Churn))) +
geom_bar(fill = "steelblue") +
labs(title = "Customer Churn Distribution", x = "Churned", y
= "Count",
)
prop.table(table(business_data$Churn))
prop.table(table(business_data$Churn)) * 100
class_counts <- table(business_data$Churn)
imbalance_ratio <- class_counts[1] / class_counts[2]  # 0/1 or No/Yes
imbalance_ratio
imbalance_table <- data.frame(
Class = names(class_counts),
Count = as.numeric(class_counts),
Percentage = round(prop.table(class_counts) * 100, 2)
)
imbalance_table
ggplot(business_data, aes(x = Churn)) +
geom_bar(fill = c("steelblue", "orange")) +
geom_text(stat = "count",
aes(label = paste0(..count.., "\n(",
round(..count../sum(..count..)*100, 1), "%)")),
vjust = -0.5) +
labs(
title = "Customer Churn Distribution",
x = "Churn Status",
y = "Count"
) +
ylim(0, max(table(business_data$Churn)) * 1.2)
data_clean <- na.omit(business_data)
categorical_vars <- names(data_clean)[sapply(data_clean, is.factor)]
categorical_vars
categorical_vars <- c(
"Gender","ContractType","PaymentMethod","InternetService",
"OnlineSecurity","TechSupport","StreamingTV",
"StreamingMovies","LoyaltyProgram"
)
data_clean[categorical_vars] <- lapply(
data_clean[categorical_vars],
factor
)
data_clean$Churn <- factor(data_clean$Churn,
levels = c(0,1),
labels = c("No","Yes"))
str(data_clean)
numeric_vars <- names(data_clean)[sapply(data_clean, is.numeric)]
numeric_vars
numeric_vars <- c(
"Age",
"TenureMonths",
"MonthlyCharges",
"TotalCharges",
"NumSupportTickets",
"SatisfactionScore"
)
preproc <- preProcess(
data_clean[, numeric_vars],
method = c("center", "scale")
)
data_scaled <- data_clean
data_scaled[, numeric_vars] <- predict(
preproc,
data_clean[, numeric_vars]
)
# Before scaling
sapply(data_clean[, numeric_vars], mean)
sapply(data_clean[, numeric_vars], sd)
# After scaling
sapply(data_scaled[, numeric_vars], mean)
sapply(data_scaled[, numeric_vars], sd)
str(data_clean)
set.seed(2026)
# Stratified split data_clean
train_index <- createDataPartition(data_clean$Churn, p = 0.7, list = FALSE)
train_data <- data_clean[train_index, ]
test_data  <- data_clean[-train_index, ]
train_index <- createDataPartition(data_scaled$Churn, p = 0.7, list = FALSE)
train_scaled <- data_scaled[train_index, ]
test_data  <- data_scaled[-train_index, ]
cat("Training Set:\n")
print(table(train_data$Churn))
prop.table(table(train_data$Churn))
cat("\nTesting Set:\n")
print(table(test_data$Churn))
prop.table(table(test_data$Churn))
train_prop <- prop.table(table(train_data$Churn))
test_prop  <- prop.table(table(test_data$Churn))
prop_df <- data.frame(
Class = rep(names(train_prop), 2),
Proportion = c(as.numeric(train_prop), as.numeric(test_prop)),
Dataset = rep(c("Train", "Test"), each = length(train_prop))
)
ggplot(prop_df, aes(x = Class, y = Proportion, fill = Dataset)) +
geom_bar(stat = "identity", position = "dodge") +
labs(title = "Class Proportions: Train vs Test Set",
x = "Class",
y = "Proportion") +
theme_minimal()
ctrl <- trainControl(
method = "cv",                     #cross-validation
number = 10,                       #10 fold
savePredictions = "final",         # Save predictions
classProbs = TRUE,                 # Enable probability predictions
summaryFunction = twoClassSummary, # ROC, Sens, Spec
verboseIter = FALSE                # Suppress iteration output
)
log_model <- train(
Churn ~ Age + Gender + TenureMonths + MonthlyCharges +
ContractType + PaymentMethod + InternetService +
SatisfactionScore + LoyaltyProgram,
data = train_data,
method = "glm",
family = binomial,
trControl = ctrl
)
coef_table <- summary(log_model$finalModel)$coefficients
coef_table
odds_ratios <- exp(coef(log_model$finalModel))
odds_ratios
# Extract coefficients and compute Odds Ratios
